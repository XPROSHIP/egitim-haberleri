{
  "name": "egitim-haberleri",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "lint": "oxlint",
    "preview": "npm run build && wrangler dev",
    "collect": "node worker/scripts/collect-local.mjs",
    "dev:worker": "wrangler dev --config worker/wrangler.jsonc",
    "deploy:worker": "wrangler deploy --config worker/wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "he": "^2.0.0",
    "i18next": "^26.5.2",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.1"
  }
}
