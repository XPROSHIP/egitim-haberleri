# Bu dosyayı kopyalayıp `.env` adıyla kaydedin ve kendi değerlerinizi girin.

# Supabase proje adresi (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase "anon public" anahtarı (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Canlı haber API'si (Cloudflare Worker adresi). Deploy edilene kadar boş kalabilir.
VITE_API_URL=https://egitim-haberleri-api.example.workers.dev